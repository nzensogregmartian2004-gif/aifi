generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AidRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  DISBURSING // décaissement MyPVit en cours : verrou anti double-envoi, voir aid-request.service.ts
  DISBURSED
  REPAID
  LATE
}

enum Role {
  CLIENT
  ADMIN
}

enum WithdrawalStatus {
  PENDING
  APPROVING // envoi MyPVit en cours : verrou anti double-envoi, voir withdrawal.service.ts
  APPROVED
  REJECTED
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  note       String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model PaymentTransaction {
  id                  String        @id @default(uuid())
  reference           String        @unique // notre référence, envoyée à MyPVit (merchant_reference_id)
  providerTransactionId String?     // reference_id / transactionId renvoyé par MyPVit
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  aidRequestId        String?
  aidRequest          AidRequest?   @relation(fields: [aidRequestId], references: [id])
  amount              Int
  operator            String?
  purpose             String?       // "PREMIUM_SUBSCRIPTION" pour un abonnement AIFI+, null pour un remboursement classique
  status              PaymentStatus @default(PENDING)
  rawInitResponse     Json?
  rawCallback         Json?
  staleNotifiedAt     DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
  @@index([aidRequestId])
}

model User {
  id             String     @id @default(uuid())
  name           String
  phone          String     @unique
  passwordHash   String
  role           Role       @default(CLIENT)
  status         UserStatus @default(PENDING)
  points         Int        @default(0)
  ceiling        Int        @default(0)
  isPremium      Boolean    @default(false)
  premiumSince   DateTime?
  premiumExpiresAt DateTime?
  referralCode   String     @unique
  referredById   String?
  referredBy     User?      @relation("Referrals", fields: [referredById], references: [id])
  referrals      User[]     @relation("Referrals")
  createdAt      DateTime   @default(now())
  anonymizedAt   DateTime?
  pushToken      String?
  // Incrémenté à chaque changement/réinitialisation de mot de passe : invalide les anciens tokens.
  tokenVersion   Int        @default(0)
  lastSeenAt   DateTime?
  identityVerification IdentityVerification?

  aidRequests    AidRequest[]
  walletEntries  WalletEntry[]
  notifications  Notification[]
  withdrawals    Withdrawal[]
  repaymentDeclarations RepaymentDeclaration[]
  auditLogs      AuditLog[] @relation("AdminAuditLogs")
  clientMessages Message[]  @relation("ClientMessages")
  sentMessages   Message[]  @relation("SentMessages")
  paymentTransactions PaymentTransaction[]
}

model AidRequest {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id])
  amount               Int
  amountDue            Int
  status               AidRequestStatus  @default(PENDING)
  dueDate              DateTime?
  durationDays         Int?
  durationTierAmount   Int?
  receivingOperator    String?
  receivingPhone       String?
  receivingName        String?
  reminderSentAt       DateTime?
  dueTodayReminderSentAt DateTime?
  latePenaltyAppliedAt DateTime?
  latePenaltySteps    Int       @default(0)
  createdAt            DateTime          @default(now())

  repayments           Repayment[]
  repaymentDeclarations RepaymentDeclaration[]
  paymentTransactions  PaymentTransaction[]
}

model Repayment {
  id           String     @id @default(uuid())
  aidRequestId String
  aidRequest   AidRequest @relation(fields: [aidRequestId], references: [id])
  amount       Int
  isPartial    Boolean    @default(false)
  proofImageUrl String?
  createdAt    DateTime   @default(now())
}

model WalletEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  createdAt DateTime @default(now())
}

model Withdrawal {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  amount    Int
  status    WithdrawalStatus @default(PENDING)
  proofImageUrl String?
  receivingOperator String?
  receivingPhone    String?
  receivingName     String?
  createdAt DateTime         @default(now())
}

model Notification {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  aidRequestId String?
  type         String
  message      String
  read         Boolean  @default(false)
  sentAt       DateTime @default(now())
}

model AppSettings {
  id                 String @id @default("singleton")
  referralBonus      Int    @default(100)
  referralPoints     Int    @default(5)
  commissionPercent  Int    @default(2)
  minWithdrawal      Int    @default(1000)
  minRepaymentAmount Int    @default(500)
  latePenaltyPoints  Int    @default(10)
  reminderDaysBefore Int    @default(2)
  serviceFeePercent  Int    @default(33)
  premiumServiceFeePercent  Int @default(25)
  premiumCeilingMultiplier  Int @default(3)
  premiumMaxCeiling         Int @default(150000)
  premiumMonthlyPrice       Int @default(5000)
  premiumGraceDays          Int @default(3)
  lateStepDays              Int @default(3)
  lateBlockDays             Int @default(15)
  repaymentReceivingOperator String @default("AIRTEL_MONEY") // où le client envoie un remboursement manuel
  repaymentReceivingPhone    String @default("")
  repaymentReceivingName     String @default("")
  communityMessage   String @default("")
  communityShareText String @default("")
  communityLinks     Json   @default("[]")
}

model DurationTier {
  id           String @id @default(uuid())
  minAmount    Int    @unique
  durationDays Int
}

enum DeclarationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model RepaymentDeclaration {
  id           String            @id @default(uuid())
  aidRequestId String
  aidRequest   AidRequest        @relation(fields: [aidRequestId], references: [id])
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  amount       Int
  status       DeclarationStatus @default(PENDING)
  note         String?
  proofImageUrl String?
  createdAt    DateTime          @default(now())
  resolvedAt   DateTime?
}

model Message {
  id        String   @id @default(uuid())
  clientId  String
  client    User     @relation("ClientMessages", fields: [clientId], references: [id])
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  senderRole Role
  text      String?
  imageUrl  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
}

model CeilingTier {
  id        String @id @default(uuid())
  minPoints Int    @unique
  ceiling   Int
}

// Fichier téléversé (justificatif, photo) et son propriétaire : un client ne peut
// joindre à ses messages ou déclarations que des fichiers qu'il a lui-même envoyés.
model Upload {
  id        String   @id @default(uuid())
  url       String   @unique
  ownerId   String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model IdentityVerification {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  documentType String
  frontUrl     String
  backUrl      String?
  extraUrls    String[]  @default([])
  status       String    @default("PENDING")
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Gift {
  id         String   @id @default(uuid())
  adminId    String
  target     String
  userId     String?
  type       String
  amount     Int
  message    String
  recipients Int      @default(0)
  createdAt  DateTime @default(now())
}
