# Copier dans .env en local ou configurer ces variables dans Render.
# Ne jamais committer .env et ne jamais mettre de vraies valeurs dans une archive.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
PORT=4000
JWT_SECRET=GENERER_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_CARACTERES
ALLOW_DATA_RESET=false
CORS_ORIGINS=https://votre-frontend.example
UPLOAD_DIR=uploads

# MyPVit — renseigner les valeurs exactes fournies par le prestataire.
MYPVIT_BASE_URL=https://api.mypvit.pro
MYPVIT_API_PASSWORD=
MYPVIT_CALLBACK_URL_CODE=
MYPVIT_RECEPTION_URL_CODE=
MYPVIT_OPERATION_ACCOUNT_CODE_AIRTEL=
MYPVIT_OPERATION_ACCOUNT_CODE_MOOV=
MYPVIT_OPERATION_ACCOUNT_CODE_CARD=
MYPVIT_URLCODE_RENEW_SECRET=
MYPVIT_URLCODE_REST=
MYPVIT_URLCODE_LINK=
MYPVIT_URLCODE_BALANCE=
MYPVIT_URLCODE_STATUS=
MYPVIT_URLCODE_KYC=
MYPVIT_URLCODE_GET_FEES=
MYPVIT_URLCODE_QR_CODE=
MYPVIT_URLCODE_GET_OPERATORS=
MYPVIT_URLCODE_GET_COUNTRIES=
MYPVIT_URLCODE_HEALTH=
# IP officielles MyPVit séparées par des virgules. Obligatoire pour activer
# le webhook de réception de clé; demander la liste au support MyPVit.
MYPVIT_WEBHOOK_ALLOWED_IPS=
